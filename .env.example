# Variables para docker compose (cópialo a .env; .env está en .gitignore).
# La configuración completa del backend está en backend/.env.example.

DCG_PORT=8000                 # puerto publicado en el host
DCG_ENV=dev                   # dev | prod
DCG_SIMULATION=true           # ESP32 virtual + rostros sintéticos (solo dev)
DCG_FACE_PROVIDER=auto        # auto | insightface | mock
DCG_COOKIE_SECURE=false       # true detrás de HTTPS (obligatorio en prod)

# Obligatorios en prod (≥ 43 caracteres). Genera con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Déjalos comentados en dev: un valor vacío se rechaza.
# DCG_JWT_SECRET=
# DCG_MASTER_KEY=
