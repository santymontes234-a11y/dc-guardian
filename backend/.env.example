# Copia este archivo a backend/.env y ajusta los valores.
DCG_ENV=dev                 # dev | test | prod

# Por defecto: sqlite:///<proyecto>/data/dcguardian.db
# DCG_DATABASE_URL=sqlite:////ruta/absoluta/dcguardian.db

# En dev, si no se definen, se generan y guardan en data/.dev_keys.json.
# En prod son obligatorios. Genera valores con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# DCG_JWT_SECRET=
# DCG_MASTER_KEY=

DCG_JWT_EXPIRE_MINUTES=60
DCG_COOKIE_SECURE=false     # true si se sirve por HTTPS (obligatorio en prod)
DCG_LOGIN_MAX_FAILURES=5
DCG_LOGIN_LOCKOUT_MINUTES=15

DCG_ACCESS_SESSION_TIMEOUT_S=30
DCG_DEVICE_CLOCK_SKEW_S=30
DCG_FACE_THRESHOLD=0.45
DCG_FACE_FRAMES=5
DCG_FACE_MIN_MATCHES=3

# Registro facial (Registro 1)
DCG_FACE_PROVIDER=auto      # auto (InsightFace) | insightface | mock (solo pruebas: acepta cualquier imagen)
DCG_FACE_MODEL=buffalo_l    # se descarga en data/models la primera vez; fallback buffalo_s
DCG_FACE_ENROLL_MIN_SAMPLES=3
DCG_FACE_ENROLL_MAX_SAMPLES=5
DCG_FACE_DUPLICATE_THRESHOLD=0.45   # rostro ya registrado para otro ingeniero (≤ DCG_FACE_THRESHOLD)

# --- Motor de acceso y dispositivos (F5) ---
DCG_ACCESS_POLL_MS=500        # cada cuánto sondea el ESP32 la decisión (300-2000)
DCG_GRANTED_VALID_S=10        # un GRANTED debe ejecutarse (abrir) en este plazo
DCG_DEVICE_OFFLINE_S=45       # sin latido durante más tiempo → OFFLINE + alerta DEVICE_OFFLINE
DCG_DEVICE_HEARTBEAT_S=15     # periodo de latido que se envía al ESP32
DCG_FAILURE_MAX=3             # fallos de una tarjeta en DCG_FAILURE_WINDOW_MINUTES...
DCG_FAILURE_WINDOW_MINUTES=5
DCG_CARD_LOCK_MINUTES=10      # ...la bloquean este tiempo (alerta REPEATED_FAILURES)
DCG_EXIT_WINDOW_HOURS=24      # una entrada más antigua ya no cuenta como "dentro" para la salida
# DCG_KIOSK_TOKEN=            # token del kiosco; si falta, se deriva de DCG_MASTER_KEY

# --- Entrada principal (QR en recepción → LED verde) ---
DCG_ENTRANCE_DEVICE_CODE=DC-DOOR-01   # ESP32 que enciende el LED verde de la entrada
# DCG_ENTRANCE_AREA_CODE=ENTRADA_PRINCIPAL
# DCG_ENTRANCE_LED_MS=5000            # tiempo del LED verde tras un QR válido (1000-10000)
# DCG_ENTRANCE_SIGNAL_TTL_S=10        # una señal no entregada en este plazo queda EXPIRADA
# DCG_QR_SCAN_RATE_PER_MINUTE=20      # escaneos por minuto por cliente (429 si se supera)

# --- Ambiente de la sala (DHT11) ---
DCG_TEMP_HIGH_C=27          # ventilador encendido; se apaga por debajo de este valor - 1 (histéresis)
DCG_TEMP_CRITICAL_C=32      # alarma (mayor que DCG_TEMP_HIGH_C)
DCG_HUMIDITY_LOW_PCT=20     # fuera de [bajo, alto] → alarma y alerta HUMEDAD_FUERA_DE_RANGO
DCG_HUMIDITY_HIGH_PCT=80
# DCG_ENVIRONMENT_RETENTION_DAYS=7    # las lecturas más antiguas se purgan

# --- Avisos por Telegram (alertas → móvil del administrador) ---
# 1) En Telegram habla con @BotFather, crea un bot (/newbot) y copia su token.
# 2) Escribe algo al bot (o añádelo a un grupo) y abre https://api.telegram.org/bot<TOKEN>/getUpdates
#    para leer el chat id (negativo en grupos). El token es un SECRETO: solo en este archivo, nunca en git.
# Con ambos valores vacíos o comentados, los avisos están desactivados. Prueba el envío en Alertas → «Enviar mensaje de prueba».
# DCG_TELEGRAM_BOT_TOKEN=
# DCG_TELEGRAM_CHAT_ID=
# DCG_TELEGRAM_MIN_SEVERITY=WARN      # INFO | WARN | CRITICAL: nivel mínimo que se envía
# DCG_TELEGRAM_RATE_PER_MINUTE=20     # tope de mensajes por minuto (evita inundar el chat)
# DCG_TELEGRAM_TIMEOUT_S=5
# DCG_SITE_NAME=Telecom Conecta       # nombre que encabeza cada mensaje
